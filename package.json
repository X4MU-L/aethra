{
  "name": "aethra",
  "version": "0.1.0",
  "description": "Aethra Client Engineering Workbench — local developer platform for client project delivery",
  "type": "module",
  "bin": {
    "aethra": "./dist/cli/index.js",
    "aethra-mcp": "./dist/mcp/server.js"
  },
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "agentation-mcp": "^1.3.2",
    "better-sqlite3": "^12.11.1",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cosmiconfig": "^9.0.0",
    "execa": "^9.3.0",
    "fs-extra": "^11.2.0",
    "glob": "^11.0.0",
    "inquirer": "^12.0.0",
    "js-yaml": "^4.1.0",
    "marked": "^13.0.0",
    "ora": "^8.1.0",
    "p-limit": "^6.1.0",
    "playwright": "^1.47.0",
    "semver": "^7.6.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/fs-extra": "^11.0.0",
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/semver": "^7.5.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "aethra",
    "developer-tools",
    "client-engineering",
    "workbench",
    "audit",
    "ai-agents"
  ],
  "author": "Aethra Solutions",
  "license": "UNLICENSED",
  "files": [
    "dist",
    "templates",
    "integrations",
    "README.md"
  ]
}